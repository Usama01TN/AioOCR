# OcrRoute environment — copy to .env
OCRROUTE_HOME=~/.ocrroute
OCRROUTE_HOST=0.0.0.0
OCRROUTE_PORT=20256
OCRROUTE_PANEL_PORT=20257
OCRROUTE_SECRET_KEY=
OCRROUTE_LOG_LEVEL=INFO
OCRROUTE_LOG_JSON=true
OCRROUTE_PRIVACY_MODE=false
OCRROUTE_CACHE_ENABLED=true
OCRROUTE_CACHE_TTL_SECONDS=86400
OCRROUTE_MAX_UPLOAD_BYTES=52428800
OCRROUTE_ALLOW_PRIVATE_URLS=false
OCRROUTE_CORS_ORIGINS=
OCRROUTE_BREAKER_THRESHOLD=5
OCRROUTE_BREAKER_COOLDOWN_SECONDS=120
