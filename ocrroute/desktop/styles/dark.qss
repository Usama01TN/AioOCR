QMainWindow, QWidget {
  background: #0b0f14;
  color: #e5e7eb;
  font-size: 13px;
}
QListWidget {
  background: #06080c;
  color: #e5e7eb;
  border: none;
}
QListWidget::item:selected { background: #2563eb; }
QPushButton {
  background: #2563eb;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 6px;
}
QPlainTextEdit {
  background: #151b23;
  border: 1px solid #1f2937;
  border-radius: 8px;
  color: #e5e7eb;
}
